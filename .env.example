# PostgreSQL Configuration
POSTGRES_DB=vorzak
POSTGRES_USER=vorzak
POSTGRES_PASSWORD=vorzak_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vorzak
SPRING_DATASOURCE_USERNAME=vorzak
SPRING_DATASOURCE_PASSWORD=vorzak_secret

# Server Ports
SERVER_PORT=8080
IMAGE_WORKER_PORT=8001
IMAGE_WORKER_URL=http://localhost:8001

# TinyFish Integration
# Official Docs: https://tinyfish.ai
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai
MAX_AGENT_STEPS=20
TINYFISH_AGENT_ENABLED=false

# Storage & Security
EVIDENCE_STORAGE_PATH=./data/evidence
EVIDENCE_RETENTION_DAYS=7
MAX_UPLOAD_SIZE_MB=10
